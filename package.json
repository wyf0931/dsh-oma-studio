{
  "name": "dsh-oma-studio",
  "version": "0.2.3",
  "description": "OMA Studio (Oh My Agent) — build, edit and manage DeepSeek Harness agent presets as a deterministic agent team, from the Settings page or an agent tool.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "oma",
    "agent-preset",
    "agent-team",
    "subagent",
    "bundle"
  ],
  "license": "MIT",
  "author": "wyf0931",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf0931/dsh-oma-studio.git"
  },
  "homepage": "https://github.com/wyf0931/dsh-oma-studio#readme",
  "bugs": {
    "url": "https://github.com/wyf0931/dsh-oma-studio/issues"
  }
}
